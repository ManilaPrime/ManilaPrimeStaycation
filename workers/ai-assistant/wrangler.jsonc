{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "manilaprime-ai-assistant",
  "main": "index.js",
  "compatibility_date": "2024-09-23",
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "manilaprime-knowledge"
    }
  ]
}
